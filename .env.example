GROQ_API_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local Postgres (docker compose service `postgres`)
POSTGRES_PASSWORD=
MAIP_APP_PASSWORD=
# >= 32 chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# For running the backend on the host (compose sets its own for the container)
DATABASE_URL=postgresql+psycopg://maip_app:<MAIP_APP_PASSWORD>@localhost:5433/maip
DOCUMENT_STORAGE_DIR=./data/documents
